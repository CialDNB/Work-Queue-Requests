# npm's native dependency cooldown: never RESOLVE a version published in the last day.
#
# `min-release-age` landed in npm 11.10 and is the direct equivalent of pnpm's
# `minimumReleaseAge` — npm's unit is DAYS (pnpm's is minutes), so 1 is the 24h window.
# npm flattens it into a rolling `before=<now-1d>` while building the tree, which you can
# see with `npm config list`.
#
# This is the seatbelt, not the gate. It only bites where npm RESOLVES versions
# (`npm install`, `npm update`, `npm view`) and on npm >= 11.10 — it does nothing for
# `npm ci`, which installs the lockfile verbatim and is what CI runs. The enforceable half
# is `npm run verify:deps` (scripts/check-dependency-age.mjs), which checks every entry in
# package-lock.json against the registry's publish times and hard-fails CI.
#
# Never commit an auth token here. Registry credentials belong in the environment
# (NODE_AUTH_TOKEN), never in a tracked file.
min-release-age=1
