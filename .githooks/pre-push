#!/usr/bin/env bash
# Editor-agnostic git hook (install once per clone: npm run hooks:install). Blocks pushes to a
# protected branch for ANY tool. The guard logic lives in the CODEOWNERS-protected
# .claude/hooks/lib/; this file is a thin dispatcher that hands git's stdin to it.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
exec node "$root/.claude/hooks/lib/block-protected-push.mjs"
